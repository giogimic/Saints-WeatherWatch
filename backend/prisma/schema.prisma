// Saints Weather Watch database schema
// SQLite now, Postgres-ready later (swap provider + DATABASE_URL).

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "go run github.com/steebchen/prisma-client-go"
  output   = "../internal/store/gen"
}

model User {
  id                  String   @id @default(cuid())
  chaserName          String   @unique
  chaserNameNorm      String   @unique
  pinHash             String
  email               String?  @unique
  equippedVehicleKey  String   @default("starter_car")
  xp                  Int      @default(0)
  level               Int      @default(1)
  stormCredits        Int      @default(75)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sessions             Session[]
  quizAttempts         QuizAttempt[]
  vehicles             UserVehicle[]
  collectibles         UserCollectible[]
  tradeListings        TradeListing[] @relation("SellerListings")
  researchLogs         ResearchLogEntry[]
  favoriteCameras      FavoriteCamera[]
  watchedAreas         WatchedArea[]
  savedLocations       SavedLocation[]
  dashboardPreference  DashboardPreference?
  deployables          Deployable[]

  @@index([createdAt])
  @@index([level])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model QuizAttempt {
  id         String   @id @default(cuid())
  userId     String?
  playerName String
  category   String   // science | radar | safety | history
  score      Int
  total      Int
  seconds    Int
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([category, score])
  @@index([createdAt])
  @@index([userId, category])
}

model UserVehicle {
  id         String   @id @default(cuid())
  userId     String
  vehicleKey String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, vehicleKey])
  @@index([userId])
}

/// Field loot / crafting materials (profile inventory stacks).
model UserCollectible {
  id        String   @id @default(cuid())
  userId    String
  itemKey   String
  count     Int      @default(1)
  firstAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemKey])
  @@index([userId])
}

/// Storm World Phase 4 — personal weather research grants (SIM loot from real WX context).
/// Copies alert metadata for the log only; never mutates NWS payloads.
model ResearchLogEntry {
  id        String   @id @default(cuid())
  userId    String
  alertId   String
  headline  String
  severity  String
  area      String
  itemKey   String
  qty       Int      @default(1)
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, alertId])
}

/// Barter listings for the Trade Center (server-authoritative).
model TradeListing {
  id           String   @id @default(cuid())
  sellerId     String
  offerKey     String
  offerQty     Int
  askKey       String
  askQty       Int
  status       String   @default("open") // open | sold | cancelled
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  buyerId      String?
  completedAt  DateTime?

  seller User @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([sellerId])
}

/// Phase 5 — player-placed world entities (probes, stations).
/// Power / upkeep / collect-later loop. Co-op: public flag lets others collect.
model Deployable {
  id          String   @id @default(cuid())
  userId      String
  kind        String   // basic_probe | solar_probe | weather_station
  label       String   @default("")
  lat         Float
  lng         Float
  health      Int      @default(100)  // 0–100, decays over time
  fuel        Int      @default(100)  // 0–100, drains each tick
  public      Boolean  @default(false) // co-op: others can collect
  yieldKey    String   @default("research_sample")
  yieldStored Int      @default(0)     // accumulated yield ready to collect
  lastCollect DateTime @default(now())
  placedAt    DateTime @default(now())
  expiresAt   DateTime // decay deadline

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lat, lng])
  @@index([expiresAt])
}

model FavoriteCamera {
  id       String   @id @default(cuid())
  userId   String
  cameraId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cameraId])
  @@index([userId])
}

model WatchedArea {
  id          String   @id @default(cuid())
  userId      String
  label       String
  lat         Float
  lon         Float
  radiusMiles Int      @default(50)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DashboardPreference {
  id          String @id @default(cuid())
  userId      String @unique
  cardOrder   String @default("profile,progress,garage,loot,cams,areas,map")
  hiddenCards String @default("")
  mapLayers   String @default("radar,warnings,cams")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChaseLogEntry {
  id          String   @id @default(cuid())
  title       String
  chaseDate   DateTime
  state       String
  lat         Float?
  lon         Float?
  efRating    Int?     // 0-5, null = unconfirmed
  milesDriven Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())

  @@index([chaseDate])
  @@index([state])
}

model SavedLocation {
  id     String  @id @default(cuid())
  userId String?
  label  String
  lat    Float
  lon    Float

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lat, lon])
  @@index([userId])
}

model TrackerIncident {
  id          String   @id
  headline    String
  category    String
  severity    String
  area        String
  // maine | usa | canada | global — archive sections
  scope       String   @default("maine")
  source      String   @default("NWS API")
  sourceUrl   String?
  eventCode   String?
  office      String?
  status      String   @default("expired")
  datePulled  DateTime @default(now())
  startsAt    String?
  endsAt      String?
  description String?
  isTornado   Boolean  @default(false)

  @@index([scope, datePulled])
  @@index([source, office])
  @@index([category, datePulled])
}

// OutageSnapshot — Phase A impact desk history (ODIN rollups).
model OutageSnapshot {
  id           String   @id @default(cuid())
  scope        String   @default("maine") // maine | national
  metersOut    Int      @default(0)
  countiesOut  Int      @default(0)
  nationalOut  Int      @default(0)
  summaryJson  String?
  source       String   @default("ODIN")
  sampledAt    DateTime @default(now())

  @@index([scope, sampledAt])
}
