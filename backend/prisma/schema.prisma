// Saints Weather Watch database schema
// SQLite now, Postgres-ready later (swap provider + DATABASE_URL).

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "go run github.com/steebchen/prisma-client-go"
  output   = "../internal/store/gen"
}

model QuizAttempt {
  id         String   @id @default(cuid())
  playerName String
  category   String   // science | radar | safety | history
  score      Int
  total      Int
  seconds    Int
  createdAt  DateTime @default(now())

  @@index([category, score])
  @@index([createdAt])
}

model ChaseLogEntry {
  id          String   @id @default(cuid())
  title       String
  chaseDate   DateTime
  state       String
  lat         Float?
  lon         Float?
  efRating    Int?     // 0-5, null = unconfirmed
  milesDriven Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())

  @@index([chaseDate])
  @@index([state])
}

model SavedLocation {
  id    String @id @default(cuid())
  label String
  lat   Float
  lon   Float

  @@index([lat, lon])
}
model TrackerIncident {
  id          String   @id
  headline    String
  category    String
  severity    String
  area        String
  datePulled  DateTime @default(now())
  startsAt    String?
  endsAt      String?
  description String?
  isTornado   Boolean  @default(false)

  @@index([category, datePulled])
}
