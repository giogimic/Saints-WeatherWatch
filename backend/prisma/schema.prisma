// Saints Weather Watch database schema
// SQLite now, Postgres-ready later (swap provider + DATABASE_URL).

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "go run github.com/steebchen/prisma-client-go"
  output   = "../internal/store/gen"
}

model User {
  id                  String   @id @default(cuid())
  chaserName          String   @unique
  chaserNameNorm      String   @unique
  pinHash             String
  email               String?  @unique
  equippedVehicleKey  String   @default("starter_car")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sessions             Session[]
  quizAttempts         QuizAttempt[]
  vehicles             UserVehicle[]
  favoriteCameras      FavoriteCamera[]
  watchedAreas         WatchedArea[]
  savedLocations       SavedLocation[]
  dashboardPreference  DashboardPreference?

  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model QuizAttempt {
  id         String   @id @default(cuid())
  userId     String?
  playerName String
  category   String   // science | radar | safety | history
  score      Int
  total      Int
  seconds    Int
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([category, score])
  @@index([createdAt])
  @@index([userId, category])
}

model UserVehicle {
  id         String   @id @default(cuid())
  userId     String
  vehicleKey String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, vehicleKey])
  @@index([userId])
}

model FavoriteCamera {
  id       String   @id @default(cuid())
  userId   String
  cameraId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cameraId])
  @@index([userId])
}

model WatchedArea {
  id          String   @id @default(cuid())
  userId      String
  label       String
  lat         Float
  lon         Float
  radiusMiles Int      @default(50)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DashboardPreference {
  id          String @id @default(cuid())
  userId      String @unique
  cardOrder   String @default("profile,progress,garage,cams,areas,map")
  hiddenCards String @default("")
  mapLayers   String @default("radar,warnings,cams")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChaseLogEntry {
  id          String   @id @default(cuid())
  title       String
  chaseDate   DateTime
  state       String
  lat         Float?
  lon         Float?
  efRating    Int?     // 0-5, null = unconfirmed
  milesDriven Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())

  @@index([chaseDate])
  @@index([state])
}

model SavedLocation {
  id     String  @id @default(cuid())
  userId String?
  label  String
  lat    Float
  lon    Float

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lat, lon])
  @@index([userId])
}

model TrackerIncident {
  id          String   @id
  headline    String
  category    String
  severity    String
  area        String
  // maine | usa | canada | global — archive sections
  scope       String   @default("maine")
  source      String   @default("NWS API")
  sourceUrl   String?
  eventCode   String?
  office      String?
  status      String   @default("expired")
  datePulled  DateTime @default(now())
  startsAt    String?
  endsAt      String?
  description String?
  isTornado   Boolean  @default(false)

  @@index([scope, datePulled])
  @@index([source, office])
  @@index([category, datePulled])
}
