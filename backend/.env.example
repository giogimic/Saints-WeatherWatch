# WeatherWatch Backend Environment Configuration
# Copy to .env and adjust as needed

# Server
PORT=8080

# Database (SQLite for dev, swap to postgresql URL for production)
DATABASE_URL=file:./weatherwatch.db

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://wn.saintsgaming.net

# Polling intervals (seconds)
NWS_ALERT_INTERVAL_SEC=60
IEM_REPORT_INTERVAL_SEC=120
SPC_OUTLOOK_INTERVAL_SEC=600

# User agent for NWS API (they require identification)
USER_AGENT=WeatherWatch/1.0 (weatherwatch.app)